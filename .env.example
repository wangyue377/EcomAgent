# ===========================================
# LLM 配置（OpenAI 兼容接口）
# 可接入任意 OpenAI 兼容服务：官方 OpenAI、中转站、DeepSeek、通义千问 等
# LLM 与 Embedding 共用同一地址，无需分别配置
# ===========================================

# API 密钥
OPENAI_API_KEY=sk-your-api-key
# API 地址（中转站填中转站地址）
OPENAI_BASE_URL=https://api.openai.com/v1
# 使用的模型
MODEL_NAME=gpt-5.5

# 模型参数
TEMPERATURE=0.7

# ===========================================
# MCP 配置（第4期）
# ===========================================
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# ===========================================
# Multi-Agent 配置（第6期）
# ===========================================
MULTI_AGENT_ENABLED=false

# ===========================================
# Memory 配置（第7期）
# ===========================================
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# ===========================================
# Skill 配置（第8期）
# ===========================================
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# ===========================================
# Evaluation 配置（第9期，离线评估工具）
# ===========================================
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# ===========================================
# RAG 配置（第5期）
# ===========================================
EMBEDDING_MODEL=text-embedding-3-small
KB_DIR=app/agent/rag/knowledge
# 向量后端：numpy（手写余弦，教学透明）/ chroma（向量数据库，生产代表）
RAG_BACKEND=numpy
# NumpyBackend 索引文件
KB_INDEX_PATH=app/sessions/kb_index.json
# ChromaBackend 持久化目录 + collection
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb
# Embedding 独立配置（为空时自动复用 LLM 的 OPENAI_API_KEY / OPENAI_BASE_URL）
# 仅当 Embedding 服务商与 LLM 不同时才需填写：
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://other-api.example.com/v1
